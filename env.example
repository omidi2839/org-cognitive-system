# Durable cloud mode. If DATABASE_URL is absent, app runs in explicit ephemeral-memory mode for synthetic preview only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DB_POOL_MAX=5
AI_PROVIDER=mock
AI_API_KEY=
APP_ENV=preview
# Object storage is added in Build 0.3.2; do not upload confidential organizational artifacts until configured.
OBJECT_STORAGE_PROVIDER=disabled
OBJECT_STORAGE_BUCKET=
REQUIRE_DURABLE_SERVICES=false
