{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/diag/ping",
      "destination": "/api/ping.js"
    },
    {
      "source": "/api/v1/knowledge/document-query",
      "destination": "/api/document-query.js"
    },
    {
      "source": "/api/v1/knowledge/document-relations",
      "destination": "/api/document-relations.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
